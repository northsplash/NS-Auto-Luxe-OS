VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=https://www.northsplash.com
VITE_MAPILLARY_ACCESS_TOKEN=
# Lead, territory, and D2D maps use Google Maps when this key is in the Vite build
# (Vercel env for production). Enable Maps JavaScript API, Geocoding API, Places API,
# and Distance Matrix API (traffic) on the same Google Cloud project.
# Optional mapId for vector/cloud styling. OpenStreetMap is the fallback if Google fails.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
